{
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules/*"],
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "module": "ESNext",
    "target": "ESNext",
    "declaration": true,
    "lib": ["ESNext", "DOM"],
    "esModuleInterop": true,
    "moduleResolution": "node",
    "baseUrl": "src",
    "outDir": "build",
    "isolatedModules": true
  }
}
